# Copie este arquivo para .env e preencha com o app Web do Firebase.
# Sem estas chaves o site continua no ar: o pré-diagnóstico cai no
# localStorage e o painel IoT usa a simulação local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
